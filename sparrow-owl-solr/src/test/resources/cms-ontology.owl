<?xml version="1.0"?>
<rdf:RDF xmlns="http://cn.liyuan.chnplc/ontology/cms#"
     xml:base="http://cn.liyuan.chnplc/ontology/cms"
     xmlns:ui="http://example.org/ui#"
     xmlns:cms="http://www.cn-plc.com/ontology/cms#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:catalogue="http://www.nimble-project.org/catalogue#">
    <owl:Ontology rdf:about="http://www.cn-plc.com/ontology/cms">
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:comment>CMS Article Category and Standards Ontology for Chnplc</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.cn-plc.com/ontology/cms#hasCodeList -->

    <owl:AnnotationProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasCodeList"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.cn-plc.com/ontology/cms#hasAssociation -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasAssociation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#member"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#AssociationStandard"/>
        <cms:hasCodeList rdf:resource="http://www.cn-plc.com/ontology/cms#AssociationPartyCollection"/>
        <rdfs:label xml:lang="zh">团体标准</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasBusinessType -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasBusinessType">
        <rdfs:range rdf:resource="http://www.cn-plc.com/ontology/cms#BusinessType"/>
        <rdfs:label xml:lang="zh">业务类型</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasCommunicationType -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasCommunicationType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_001"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_002"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.cn-plc.com/ontology/cms#CommunicationType"/>
        <rdfs:label xml:lang="zh">通讯方式</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasCompanyStandard -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasCompanyStandard">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#member"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#CompanyStandard"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_003_001"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_005"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_007"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <cms:hasCodeList rdf:resource="http://www.cn-plc.com/ontology/cms#PowerPartyCollection"/>
        <rdfs:label xml:lang="zh">企业标准</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasCountry -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasCountry">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#member"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="zh">国家</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasDeviceType -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasDeviceType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_002"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_003_001"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_005"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.cn-plc.com/ontology/cms#DeviceType"/>
        <rdfs:label xml:lang="zh">设备类型</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasInspectStatus -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasInspectStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_005_001"/>
        <rdfs:label xml:lang="zh">送检状态</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasInternationalParty -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasInternationalParty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#member"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#InternationalStandard"/>
        <cms:hasCodeList rdf:resource="http://www.cn-plc.com/ontology/cms#InternationalPartyCollection"/>
        <rdfs:label xml:lang="zh">国际组织</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasLanguage -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasLanguage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#InternationalStandard"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#OverseasStandard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="zh">语言</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasPublishVersion -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasPublishVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_001"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_002"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="zh">发布版本</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasQualifyStatus -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasQualifyStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_005_002"/>
        <rdfs:label xml:lang="zh">验厂状态</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasRegion -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasRegion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#member"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#hasCountry"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="zh">地区</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasSplit -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasSplit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_007"/>
        <rdfs:range rdf:resource="http://www.cn-plc.com/ontology/cms#Split"/>
        <rdfs:label xml:lang="zh">分册</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasStandard -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasStandard">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_001"/>
                    <rdf:Description rdf:about="http://www.cn-plc.com/ontology/cms#M_002"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.cn-plc.com/ontology/cms#PowerStandard"/>
        <rdfs:label xml:lang="zh">标准类别</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#hasTendorStatus -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#hasTendorStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_003_001"/>
        <rdfs:label xml:lang="zh">招标状态</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#inspectParty -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#inspectParty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_005_001"/>
        <rdfs:label xml:lang="zh">检测机构</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cn-plc.com/ontology/cms#qualifyParty -->

    <owl:ObjectProperty rdf:about="http://www.cn-plc.com/ontology/cms#qualifyParty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_005_002"/>
        <rdfs:label xml:lang="zh">验厂机构</rdfs:label>
    </owl:ObjectProperty>
    


