        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_001"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="zh">标准号</rdfs:label>
    </owl:DatatypeProperty>
    


