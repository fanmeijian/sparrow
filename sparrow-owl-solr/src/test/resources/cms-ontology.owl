    <!-- http://www.cn-plc.com/ontology/cms#P_010 -->

    <owl:DatatypeProperty rdf:about="http://www.cn-plc.com/ontology/cms#P_010">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
