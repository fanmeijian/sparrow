        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_002"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#M_003_001"/>
        <rdfs:domain rdf:resource="http://www.cn-plc.com/ontology/cms#PowerStandard"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
