<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
  <persistence-unit name="rbac-test" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>cn.sparrowmini.rbac.persistence.jpa.RoleEntity</class>
<class>cn.sparrowmini.rbac.persistence.jpa.RoleAssignmentEntity</class>
<class>cn.sparrowmini.rbac.persistence.jpa.grant.RolePermissionEntity</class>
    <class>cn.sparrowmini.rbac.persistence.jpa.catalog.PermissionResourceEntity</class><class>cn.sparrowmini.rbac.persistence.jpa.catalog.PermissionScopeEntity</class><exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:rbac;DB_CLOSE_DELAY=-1"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="external-role-test" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>cn.sparrowmini.rbac.persistence.jpa.grant.RolePermissionEntity</class>
    <class>cn.sparrowmini.rbac.persistence.jpa.catalog.PermissionResourceEntity</class><class>cn.sparrowmini.rbac.persistence.jpa.catalog.PermissionScopeEntity</class><exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties><property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/><property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:external-role-test;DB_CLOSE_DELAY=-1"/><property name="hibernate.hbm2ddl.auto" value="create-drop"/></properties>
  </persistence-unit>
</persistence>
